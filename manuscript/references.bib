@ARTICLE{Ji2026,
	author = {Ji, Jiangan and Li, Xinzhe and Chen, Wanli and Gan, Shuitao and Liu, Tieming and Liu, Hangtian and Xu, Hang and Zhou, Zuozheng and Jing, Jing and Zhong, Zhenyu and Zhang, Chao},
	title = {FirmTaint: Finding Exploitable Taint-StyleVulnerabilities in IoT Firmware},
	year = {2026},
	journal = {IEEE Transactions on Dependable and Secure Computing},
	pages = {},
	doi = {10.1109/TDSC.2026.3742456},
	url = {https://www.scopus.com/pages/publications/105053783887?origin=resultslist},
	affiliations = {Information Engineering University, Zhengzhou, 450001, China; Tianjin University, Tianjin, 300354, China; Shandong University, Qingdao, 266237, China; Laboratory for Advanced Computing and Intelligence Engineering, Wuxi, 214083, China; Ant Group, Hangzhou, 310063, China; Tsinghua University, Institute for Network Sciences and Cyberspace, Beijing, 100084, China},
	abstract = {Taint-style vulnerabilities are prevalent in web servers embedded in IoT firmware. Static taint analysis is the most common approach for detecting these vulnerabilities, but it suffers from inherent limitations, including false positives in source point identification, weak reasoning on sanitizers, and imprecise taint propagation analysis. Recent work has explored the use of Large Language Models (LLMs) for taint analysis. However, purely LLM-based approaches remain limited by misaligned context, limited precision for certain vulnerability types, and overwhelming candidate paths. In addition, existing static analysis tools can only identify potentially vulnerable locations and require substantial manual effort to develop exploit scripts for validation. To overcome these limitations, we present <monospace>FirmTaint</monospace>, a hybrid framework that combines reaching definition analysis (RDA) with an LLM-driven taint agent. The RDA checker performs coarse but efficient pruning by identifying specific sanitizer patterns and analyzing buffer length relationships. This step enables a large number of harmless paths to be discarded quickly using lightweight static rules. The remaining high-risk paths are then examined by a specialized taint agent that leverages IDA MCP interfaces for automated code retrieval and vulnerability detection. In addition, <monospace>FirmTaint</monospace> reconstructs the routing table and infers exploit constraints to automatically generate executable proof-of-concept (PoC) exploits for detected alerts. We evaluated <monospace>FirmTaint</monospace> on two datasets, comparing its performance with state-of-the-art solutions including KARONTE, SaTC, Emtaint, Mango, HermeScan, and LATTE. In the 0-day dataset, <monospace>FirmTaint</monospace> identifies 275 vulnerabilities with an 89.9% precision rate. These include 142 command injection and 133 buffer overflow vulnerabilities, comprising 212 0-day and 63 N-day vulnerabilities. So far, we have been granted 56 vulnerability IDs for those 0-days. <monospace>FirmTaint</monospace> outperformed the baseline tools, which detected fewer vulnerabilities and achieved lower precision rates. For alerts generated through taint agent, <monospace>FirmTaint</monospace> successfully constructs and validates exploitable PoCs for 86.5% of the confirmed vulnerabilities. In the N-day dataset evaluated by existing works, <monospace>FirmTaint</monospace> also shows much better performance. © 2004 IEEE.},
	author_keywords = {IoT firmware; LLMs; PoC generation; taint analysis; vulnerability detection},
	keywords = {Codes (symbols); Data flow analysis; Knowledge based systems; Model checking; Network security; Static analysis; Web services; Concept generation; IoT firmware; Language model; Large language model; Performance; Precision rates; Proof of concept; Proof-of-concept generation; Taint analyze; Vulnerability detection; Firmware},
	correspondence_address = {C. Zhang; Tsinghua University, Institute for Network Sciences and Cyberspace, Beijing, 100084, China; email: chaoz@tsinghua.edu.cn},
