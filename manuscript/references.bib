@ARTICLE{Xu2026,
	author = {Xu, Zijie and Qi, Minfeng and Wu, Shiqing and Zhang, Lefeng and Wei, Qiwen and He, Han and Li, Ningran},
	title = {The Trust Paradox in LLM-Based Multi-Agent Systems: When Collaboration Becomes a Security Vulnerability},
	year = {2026},
	journal = {IEEE Transactions on Computational Social Systems},
	pages = {},
	doi = {10.1109/TCSS.2026.3695070},
	url = {https://www.scopus.com/pages/publications/105040936087?origin=resultslist},
	affiliations = {Minzu University, Beijing, 100081, China; City University of Macau, 999078, Macao; Monash University, Melbourne, 3800, VIC, Australia},
	abstract = {Multi-agent systems powered by large language models (LLMs) are advancing rapidly, yet the security implications of trust-mediated collaboration remain insufficiently understood. We introduce and empirically validate the trust–vulnerability paradox (TVP): increasing inter-agent trust to improve coordination can simultaneously amplify risks of over-exposure and authorization drift (AD). To study this phenomenon under controlled and reproducible conditions, we operationalize trust as a system-level control parameter governing authorization strictness and information disclosure, rather than as a cognitive or social construct. We construct a purpose-built scenario-game dataset spanning three macro-scenes and nineteen sub-scenes, and conduct extensive closed-loop agent-to-agent (A2A) interactions with explicit trust parameterization. Using minimum necessary information (MNI) as the safety baseline, we propose two unified metrics: over-exposure rate (OER) to quantify boundary violations, and AD to capture the sensitivity of disclosure behavior to trust variation. Experiments across multiple model backends and orchestration frameworks reveal consistent trends: higher trust improves task success but also increases over-exposure risk, with substantial heterogeneity in risk sensitivity to trust across systems. We further evaluate mitigation strategies, including Sensitive Information Repartitioning and guardian-agent (GA-Agent) enablement, which effectively reduce OER and attenuate AD under elevated trust. Overall, this work formalizes TVP as a systemic security property, establishes reproducible experimental baselines with unified metrics, and demonstrates that trust must be modelled, calibrated, and managed as a first-class security variable in the design of LLM-based multi-agent systems (LLM-MAS). © 2014 IEEE.},
	author_keywords = {Large language models (LLMs); multi-agent; security; trust–vulnerability paradox (TVP)},
	keywords = {Cognitive systems; Intelligent agents; Risk management; Exposure rate; Language model; Large language model; Model-based OPC; Multi agent; Multiagent systems (MASs); Security; Security implications; Security vulnerabilities; Trust–vulnerability paradox; Multi agent systems},
