@ARTICLE{Tashenova2026,
	author = {Tashenova, Zhuldyz and Aitmagambetuly, Aisultan and Bayegizova, Aigulim and Santeyeva, Saya and Abdugulova, Zhanat and Amanzholova, Shirin and Kerim, Akerke},
	title = {SentinelCMS: Proactive Vulnerability Detection in CMS Plugins Using Static Taint Analysis and Bidirectional LSTM},
	year = {2026},
