@ARTICLE{Yoo2025560,
	author = {Yoo, Sang Hyun and Kim, Hyun Jung},
	title = {Security Analysis of Automated Code Generation: Structural Vulnerabilities in AI-Generated Code},
	year = {2025},
	journal = {Tehnicki Glasnik},
	volume = {19},
